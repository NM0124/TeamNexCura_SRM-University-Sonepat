# Environment Configuration for Asthma Digital Twin
APP_ENV=development
APP_PORT=8501
SQLITE_DB_PATH=data/processed/asthma_twin.db

# Replay settings
DEFAULT_REPLAY_INTERVAL_SEC=2.0
CSV_DATA_PATH=data/raw/synthetic_apple_health_asthma_timeseries.csv
SYNTHEA_DATA_DIR=data/raw/synthea

# Prediction settings
DEFAULT_PREDICTION_HORIZON_HOURS=6
PEF_DETERIORATION_THRESHOLD_PCT=0.80
BASELINE_WINDOW_HOURS=72
